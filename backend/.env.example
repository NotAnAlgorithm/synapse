# Synapse service — environment template. Copy to `.env` and fill locally.
# NEVER commit real secrets. `.env` is gitignored.

# --- Supabase project (dashboard -> Settings -> API Keys) -------------------
SUPABASE_URL=
# Secret key (sb_secret_...): server-side ONLY (Edge Functions + ingest script).
# Bypasses RLS, so it must never reach a client. Set as a function secret in
# deployment (`supabase secrets set`), not baked into any client bundle. (The
# legacy service_role JWT still works as a fallback and is auto-injected into
# deployed functions.)
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...): safe for client-side calls once real
# per-user auth exists (M2 design §3). Replaces the legacy anon key.
SUPABASE_PUBLISHABLE_KEY=

# --- LLM / embedding provider ------------------------------------------------
# Provider selected in _shared/provider.ts. "openai" is implemented (Chat
# Completions + Embeddings); "stub" refuses instead of fabricating (keeps the
# pipeline honest until a provider is set).
SYNAPSE_PROVIDER=stub
# Model ids (switching models is env-only). For OpenAI: any chat model for the
# generator; an embedding model for the embedder (e.g. text-embedding-3-small =
# 1536 dims, text-embedding-3-large = 3072).
SYNAPSE_GENERATOR_MODEL=
SYNAPSE_EMBEDDER_MODEL=
# Embedding dimension MUST match the vector column in BOTH
# supabase/migrations/0001_init_corpus.sql and 0003_match_fn.sql (default 1536).
# For OpenAI the adapter pins output width to this via the `dimensions` param.
SYNAPSE_EMBEDDING_DIM=1536
# Optional: OpenAI-compatible base URL (Azure / a gateway). Defaults to the
# public OpenAI API when unset.
# SYNAPSE_PROVIDER_BASE_URL=
# Provider credential — set as a function secret in deployment, or here for the
# local ingest script.
SYNAPSE_PROVIDER_API_KEY=

# --- Interim service auth (M2 design §3) -----------------------------------
# A single service-wide dev token is acceptable ONLY to exercise plumbing
# against the seed corpus. Real per-user auth is required before any multi-user
# data (F3 calibration) is collected.
SYNAPSE_DEV_TOKEN=
